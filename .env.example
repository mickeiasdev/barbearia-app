# ============================================================
# Copie este arquivo para ".env.local" e preencha com os dados
# do seu projeto Supabase (Settings -> API no dashboard)
# ============================================================

# URL do projeto Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon public" do Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public

# Nome exibido no site (opcional)
NEXT_PUBLIC_APP_NAME=BarberPro

# Domínio(s) raiz da plataforma, separados por vírgula (importante para
# os sites por subdomínio: lucas.SEUDOMINIO.com.br mostra só o Lucas).
# Inclua "localhost" para testar localmente com lucas.localhost:3000.
# NEXT_PUBLIC_ROOT_DOMAINS=seudominio.com.br,localhost

# URL pública do site — usada no sitemap (opcional em dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# OPCIONAIS — e-mails transacionais via Resend (https://resend.com)
# Sem estas variáveis o app funciona normalmente; os e-mails só
# são enviados quando a chave estiver configurada.
# ============================================================
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=BarberPro <naoresponda@seudominio.com>

# ============================================================
# OPCIONAIS — WhatsApp via gateway (ex.: Z-API, WhatsApp Business API)
# WHATSAPP_API_URL é o endpoint de envio; o corpo enviado é
# { "phone": "5511999999999", "message": "texto" }.
# Sem estas variáveis os avisos caem só no e-mail.
# ============================================================
# WHATSAPP_API_URL=https://sua-api/instances/XXXX/send-text
# WHATSAPP_API_TOKEN=seu-token

# ============================================================
# OPCIONAIS — lembrete automático 24h antes (cron diário 09:00 BRT).
# A SERVICE ROLE key ignora RLS: use APENAS nesta rota protegida.
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# CRON_SECRET=um-segredo-qualquer

# ============================================================
# OPCIONAIS — cobrança das assinaturas dos planos (Pro/Business)
# via Pix do Mercado Pago. Sem a chave, a página /assinar avisa.
# Depois configure o webhook em MP → Suas integrações:
#   https://SEU_DOMINIO/api/webhooks/mercadopago (evento: payments)
# ============================================================
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
