# ============================================================
# Copie este arquivo para ".env.local" e preencha com os dados
# do seu projeto Supabase (Settings -> API no dashboard)
# ============================================================

# URL do projeto Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon public" do Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public

# Nome exibido no site (opcional)
NEXT_PUBLIC_APP_NAME=BarberPro

# URL pública do site — usada no sitemap (opcional em dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
